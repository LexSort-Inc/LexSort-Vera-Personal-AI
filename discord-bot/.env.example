# VERA Pro Discord Bot — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it is in .gitignore

# ─── Discord ──────────────────────────────────────────────────────────────
# Your Discord bot's token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your Discord application's client ID (from Developer Portal > General Information)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Your VERA Pro Discord server's Guild ID (right-click server > Copy Server ID)
DISCORD_GUILD_ID=your_discord_guild_id_here

# The Role ID for the "Beta Tester" role (right-click role > Copy Role ID)
DISCORD_TESTER_ROLE_ID=your_tester_role_id_here

# ─── Netlify / Site ───────────────────────────────────────────────────────
# Your production Netlify site URL (no trailing slash)
NETLIFY_SITE_URL=https://lexsort.com

# Shared secret authenticating this bot to verify-tester-status
# (must match the Netlify function env of the same name)
BOT_SHARED_SECRET=your_bot_shared_secret_here

# ─── Self-host mode ─────────────────────────────────────────────────────────
# Approval webhook listener (GitHub release approvals + Reddit posts) runs
# ONLY when 'true'. Self-hosted boxes without port-forwarding (ThinkCentre)
# run outbound-only gateway mode: leave 'false'. Needs inbound :8080.
ENABLE_APPROVAL_BOT=false

# Optional: Reddit + webhook variables (only used when ENABLE_APPROVAL_BOT=true)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
