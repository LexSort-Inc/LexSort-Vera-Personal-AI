#!/bin/bash
set -e

echo "🔒 Running contract tests before commit..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Run Rust contract tests (if test target exists)
echo "📦 Rust contract tests..."
cd vera-freeware/src-tauri
if cargo test --test contracts --quiet 2>/dev/null; then
    echo -e "${GREEN}✅ Rust contract tests passed.${NC}"
else
    echo -e "${YELLOW}⚠️  No contracts test target found; skipping.${NC}"
fi
cd ../.. > /dev/null

# Run Frontend contract tests if vitest is configured
cd vera-freeware
if [ -f "package.json" ] && grep -q "vitest" package.json; then
    echo "🌐 Frontend contract tests..."
    if ! npm test -- --run contracts --silent; then
        echo -e "${RED}❌ Frontend contract tests failed. Commit blocked.${NC}"
        exit 1
    fi
    echo -e "${GREEN}✅ Frontend contract tests passed.${NC}"
else
    echo -e "${YELLOW}⚠️  Vitest not detected; skipping frontend contract tests.${NC}"
fi
cd .. > /dev/null

echo -e "${GREEN}🎉 All contract tests passed. Proceeding with commit.${NC}"
exit 0
